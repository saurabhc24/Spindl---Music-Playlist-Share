# --- App ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000    # prod: https://spindlshare.vercel.app
AUTH_SECRET=                         # `npx auth secret` -- Auth.js session/JWT signing key

# --- Database (Neon: neon.tech, or Vercel Storage tab -> same product) ---
# Change Neon's `sslmode=require` to `sslmode=verify-full` on both. node-postgres
# treats them identically today, but pg v9 will make `require` skip certificate
# verification -- pinning verify-full avoids that silent downgrade on an upgrade.
DATABASE_URL=                        # pooled connection string (PgBouncer, "-pooler" host)
DIRECT_URL=                          # unpooled, used by `prisma migrate` (needs a real session)

# --- OAuth redirect URIs ------------------------------------------------------
# Each provider needs TWO kinds of redirect URI registered, and only one kind is
# an environment variable.
#
# 1. LOGIN (Auth.js). Derived from the request, so there is nothing to set here
#    -- but it still has to be registered in the provider's console, and it is
#    the one that is easy to forget precisely because it is not a variable:
#
#      https://spindlshare.vercel.app/api/auth/callback/google
#      https://spindlshare.vercel.app/api/auth/callback/spotify
#      http://localhost:3000/api/auth/callback/google      (local; see below)
#
#    Local login says localhost, not 127.0.0.1, and that is not a typo. `next
#    dev` reports its own origin as http://localhost:PORT whatever address you
#    browse to -- Host and X-Forwarded-Host are ignored, and AUTH_URL does not
#    override it either. Google accepts a localhost redirect URI, so Google
#    login works locally. Spotify does not: its rules say "localhost is not
#    allowed as redirect URI" and loopback must be 127.0.0.1:PORT. Since we
#    cannot make Auth.js send 127.0.0.1 in dev, and Spotify will not accept
#    localhost, SPOTIFY LOGIN ONLY WORKS AGAINST A DEPLOYED URL. Use Google or
#    the email link locally.
#
# 2. CONNECT (our own OAuth, for importing playlists). Built from the *_REDIRECT_URI
#    variables further down, so it is whatever you set -- and it does work
#    locally, because we choose the value and can choose 127.0.0.1.

# --- Login: Google (Auth.js provider) ---
GOOGLE_CLIENT_ID=                    # console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_SECRET=                # same OAuth client is reused for YouTube connect (see below)

# --- Login: Email magic link ---
AUTH_RESEND_KEY=                     # resend.com dashboard > API Keys
EMAIL_FROM="SpindlShare <noreply@yourdomain.com>"   # needs a verified sending domain in Resend

# --- Token encryption (for ConnectedAccount access/refresh tokens) ---
TOKEN_ENCRYPTION_KEY=                # `openssl rand -base64 32`, 32-byte AES-256-GCM key

# --- Spotify (playlist connect; same app also carries the login callback above) ---
SPOTIFY_CLIENT_ID=                   # developer.spotify.com/dashboard
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/connect/spotify/callback   # must use 127.0.0.1, not localhost

# --- YouTube (playlist connect; reuses GOOGLE_CLIENT_ID/SECRET above with a different redirect URI + scope) ---
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/api/connect/youtube/callback

# --- Asset storage ---
BLOB_READ_WRITE_TOKEN=               # Vercel Storage > Blob, auto-injected when store is linked

# --- Rate limiting / phase 6 ---
UPSTASH_REDIS_REST_URL=              # upstash.com free tier
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (Vercel Cron auth for /api/cron/cleanup) ---
CRON_SECRET=                         # `openssl rand -base64 32`; Vercel sends it as a Bearer token

# --- Optional tuning ---
DATABASE_POOL_MAX=5                  # pg pool size PER serverless instance; keep small

# --- Admin ---
# Comma-separated emails granted access to /admin. Deliberately an env var rather
# than a DB column: nobody can promote themselves by writing to the database.
ADMIN_EMAILS=
