// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth v5) Prisma adapter models ---
// Used exclusively for app login (Google OAuth + email magic link).
// Playlist-source connections (Spotify/YouTube) are stored separately
// in ConnectedAccount below, never here.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  profile           Profile?
  connectedAccounts ConnectedAccount[]
  playlists         Playlist[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  username    String   @unique
  displayName String?
  bio         String?  @db.VarChar(280)
  avatarUrl   String?
  theme       String   @default("default")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MusicProvider {
  SPOTIFY
  YOUTUBE
}

model ConnectedAccount {
  id                    String        @id @default(cuid())
  userId                String
  provider              MusicProvider
  providerAccountId     String?
  accessTokenEncrypted  String?       @db.Text
  refreshTokenEncrypted String?       @db.Text
  scope                 String?
  expiresAt             DateTime?
  lastSyncedAt          DateTime?
  lastSyncStatus        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists Playlist[]

  @@unique([userId, provider])
}

model Playlist {
  id                 String        @id @default(cuid())
  userId             String
  connectedAccountId String
  provider           MusicProvider
  externalId         String
  title              String
  description        String?
  coverImageUrl      String?
  externalUrl        String
  trackCount         Int?
  visible            Boolean       @default(true)
  sortOrder          Int           @default(0)
  isStale            Boolean       @default(false)
  lastSyncedAt       DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId, visible, sortOrder])
}
